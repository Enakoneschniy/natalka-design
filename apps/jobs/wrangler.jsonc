{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natalka-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The site and Stripe reach this worker on workers.dev; a preview URL per version would be one
  // more address to keep track of, so there are none.
  "preview_urls": false,
  // Logs keep what the worker writes (ids and status codes), not every request it answers.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    // The calculation and text API (Python in a container).
    "NATALKA_API_URL": "https://natalka-api.ceo-63e.workers.dev",
    // Days a document and the birth data behind it are kept.
    "RETENTION_DAYS": "30",
    // The ready letter links to the waiting screen here, which turns into the download.
    "SITE_URL": "https://chronika.me",
    // The seller cabinet; sign-in letters link to it.
    "PRO_SITE_URL": "https://pro.chronika.me",
    // Stripe Tax on Checkout: "1" once it is activated in the Stripe dashboard, which is the
    // owner's call. Declared here because vars set in the Cloudflare dashboard are wiped on deploy.
    "STRIPE_TAX": "0",
    // Where owner alerts go: payments to refund, disputes, documents that could not be made.
    "ALERT_EMAIL": "help@chronika.me"
    // Secrets, set with `wrangler secret put` and never here: DATA_KEY, LINK_KEY, SESSION_KEY,
    // PRO_API_KEY, SITE_KEY, NATALKA_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
    // RESEND_API_KEY, TEST_ORDER_KEY (optional).
  },
  // Worker-to-worker over a service binding, not a public fetch: Cloudflare refuses the latter
  // between two workers on the same zone (error 1042), and this keeps the call private and fast.
  "services": [
    { "binding": "API", "service": "natalka-api" },
    // github.com/Enakoneschniy/ephemeris-service — AGPL, public, same Cloudflare account.
    { "binding": "EPHEMERIS", "service": "ephemeris-api" },
    { "binding": "BOT", "service": "natalka-bot", "entrypoint": "BotInternal" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "natalka", "database_id": "90261635-69b9-461b-9e1f-9a7b98596e97", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "natalka-documents" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "natalka-jobs" }],
    "consumers": [
      {
        "queue": "natalka-jobs",
        // One document at a time per consumer: a reading is a long chain of model calls, and
        // batching them would only make a failure harder to place.
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "dead_letter_queue": "natalka-jobs-dlq"
      },
      {
        // What the queue above gave up on: the job is failed for good, a seller's reading settled
        // and the owner told about a shopper's (src/consumer.ts). A job another delivery is still
        // working on is looked at again later, which takes a few retries.
        "queue": "natalka-jobs-dlq",
        "max_batch_size": 10,
        "max_retries": 10
      }
    ]
  },
  "triggers": {
    // Nightly retention sweep: birth data and documents past their date are deleted.
    // Hourly: subscriptions whose horoscope is due go to the queue.
    "crons": ["17 3 * * *", "5 * * * *"]
  }
}
