{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natalka-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the deployed version answers; an uploaded version gets no address of its own.
  "preview_urls": false,
  // Errors and console output are kept; the per-request log line is not.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "NATALKA_AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f63eebad9e3bd39565a3129188e84a47/natalka/openrouter"
  },
  // Secrets, set with `wrangler secret put`: ACCESS_KEY (the jobs Worker's NATALKA_API_KEY),
  // NATALKA_MODEL_API_KEY and, once the gateway requires it, NATALKA_AI_GATEWAY_TOKEN.
  "containers": [
    {
      "class_name": "ApiContainer",
      // Built and pushed by CI (.github/workflows/container.yml); tag is rewritten on deploy.
      "image": "registry.cloudflare.com/f63eebad9e3bd39565a3129188e84a47/natalka-api:latest",
      "max_instances": 10,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
}
