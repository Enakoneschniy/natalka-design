{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natalka-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The site answers on the apex and on www; Cloudflare issues the certificates for both.
  "routes": [
    { "pattern": "chronika.me", "custom_domain": true },
    { "pattern": "www.chronika.me", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // City search reads straight from here. Going through the calculation container cost a
  // worker-to-worker hop and, when it had gone to sleep, several seconds of cold start — on the
  // first field of the first screen.
  "d1_databases": [
    { "binding": "DB", "database_name": "natalka", "database_id": "90261635-69b9-461b-9e1f-9a7b98596e97" }
  ],
  "vars": {
    // The public ephemeris service: github.com/Enakoneschniy/ephemeris-service
    "EPHEMERIS_API_URL": "https://ephemeris-api.ceo-63e.workers.dev",
    // Orders, generation progress and finished documents.
    "NATALKA_JOBS_URL": "https://natalka-jobs.ceo-63e.workers.dev",
    // The bot's public username; the waiting screen offers a Telegram link when it is set.
    "TELEGRAM_BOT_USERNAME": "chronikame_bot",
    // The one switch that opens the site to search and answer engines: robots.txt, the sitemap,
    // llms.txt and every page's metadata follow it. Turn it on when payments are live — until
    // then a reading can be had without paying, and that is not a thing to be found by.
    "SITE_INDEXABLE": "false"
  }
}
