{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natalka-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    // Calculation API (Python engine in a Cloudflare Container). Locally: http://127.0.0.1:8000.
    "NATALKA_API_URL": "https://natalka-api.ceo-63e.workers.dev",
    // Orders, generation progress and finished documents.
    "NATALKA_JOBS_URL": "https://natalka-jobs.ceo-63e.workers.dev"
  }
}
