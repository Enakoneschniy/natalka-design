# Natalka — copy to .env and fill in. Never commit .env.
# All variables are read by pydantic-settings with the NATALKA_ prefix (packages/shared/settings.py).

# dev | staging | prod
NATALKA_ENV=dev

# Postgres. docker compose -f infra/docker-compose.yml up db starts one with these credentials.
NATALKA_DATABASE_URL=postgresql://natalka:natalka@localhost:5432/natalka

# Encryption keys for birth data at rest: "v<n>:<base64 32 bytes>", newest first.
# Generate one: uv run python -c "from natalka_shared.crypto import KeyRing; print(KeyRing.generate_key())"
NATALKA_DATA_KEYS=v1:CHANGE_ME_BASE64_32_BYTES

# Signing key for order links (HS256, 30-day tokens).
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
NATALKA_JWT_SECRET=CHANGE_ME

# Object storage for generated PDFs (S3-compatible: Cloudflare R2, MinIO, S3).
NATALKA_STORAGE_ENDPOINT=
NATALKA_STORAGE_BUCKET=natalka-documents
NATALKA_STORAGE_ACCESS_KEY=
NATALKA_STORAGE_SECRET_KEY=

# LLM (texts stage). Not needed for the engine, the PDF renderer or the preview.
# Model key (OpenRouter). Locally: this file / your shell. In production: a Worker secret on
# natalka-api, passed into the container by ApiContainer.envVars. Never committed.
NATALKA_MODEL_API_KEY=
# Override the default model (anthropic/claude-sonnet-5).
NATALKA_MODEL=

# Every model call goes through Cloudflare AI Gateway instead of api.anthropic.com: per-request
# logs, token and cost analytics, retries and rate limits, all inside our own account — no third
# party sees the birth data. Empty = call the provider directly (used by tests).
NATALKA_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/f63eebad9e3bd39565a3129188e84a47/natalka/openrouter

# Failure alerts from the worker.
NATALKA_TELEGRAM_BOT_TOKEN=
NATALKA_TELEGRAM_CHAT_ID=

# Swiss Ephemeris data directory. Empty = the files bundled with packages/engine (1800–2399).
NATALKA_EPHEMERIS_PATH=

# Days birth data and PDFs are kept before the cleanup job deletes them.
NATALKA_RETENTION_DAYS=30

# --- web (apps/web, added in the next stage) ---
# Internal API base URL the web app proxies to.
NATALKA_API_URL=http://localhost:8000

# --- Cloudflare (staging) ---
# Account f63eebad9e3bd39565a3129188e84a47; wrangler reads CLOUDFLARE_API_TOKEN from the environment.
# Web:     https://natalka-web.ceo-63e.workers.dev   (apps/web, deploy: pnpm --filter @natalka/web deploy)
# Mockups: https://natalka-design.ceo-63e.workers.dev
